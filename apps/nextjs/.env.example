# Server only: these never reach the browser.
# Create an API key in the console (https://console.busyhour.id) with the
# scopes sessions:write, users:write and notifications:write.
BUSYHOUR_API_KEY=
BUSYHOUR_PROJECT_ID=

# Optional: point at another API (e.g. a local one). Defaults to
# https://api.busyhour.id. The NEXT_PUBLIC_ one is what the browser uses.
# BUSYHOUR_API_URL=
# NEXT_PUBLIC_BUSYHOUR_API_URL=
