# Server only: read by the Hono server, never bundled into the browser.
# Create an API key in the console (https://console.busyhour.id) with the
# scopes sessions:write, users:write and notifications:write.
BUSYHOUR_API_KEY=
BUSYHOUR_PROJECT_ID=

# Optional: point at another API (e.g. a local one). Defaults to
# https://api.busyhour.id. The VITE_ one is what the browser uses.
# BUSYHOUR_API_URL=
# VITE_BUSYHOUR_API_URL=

# Optional: the port `bun run start` listens on (default 8787).
# PORT=
